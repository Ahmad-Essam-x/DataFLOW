{
  "name": "nulls sort first when ascending",
  "tool": "sort",
  "provenance": "derived",
  "source": "Alteryx Sort places nulls before values in ascending order",
  "config": {
    "sort_by": [
      {
        "column": "n",
        "ascending": true
      }
    ]
  },
  "inputs": {
    "I": {
      "columns": [
        "n"
      ],
      "rows": [
        [
          2
        ],
        [
          null
        ],
        [
          1
        ]
      ]
    }
  },
  "expect": {
    "O": {
      "columns": [
        "n"
      ],
      "rows": [
        [
          null
        ],
        [
          1
        ],
        [
          2
        ]
      ]
    }
  },
  "ordered": true
}
