        "trim_whitespace": true
      },
      "container_id": "container_sales_1",
      "is_cached": false,
      "locked": false
    },
    {
      "id": "node_sales_dt",
      "type": "date_time",
      "name": "Parse OrderDate",
      "x": 640,
      "y": 180,
      "config": {
        "column": "OrderDate",
        "conversion_type": "string_to_date",
        "format_template": "yyyy-MM-dd",
        "output_column": "OrderDate_ISO"
      },
      "container_id": "container_sales_1",
      "is_cached": false,
      "locked": false
    },
    {
      "id": "node_sales_formula",
      "type": "formula",
      "name": "Calculate Net Revenue",
      "x": 820,
      "y": 180,
      "config": {
        "formulas": [
          {
            "expression": "[Quantity] * [UnitPrice]",
            "output_field": "GrossAmount",
            "type": "float"
          },
          {
            "expression": "[GrossAmount] * (1.0 - [Discount])",
            "output_field": "NetAmount",
            "type": "float"
          }
        ]
      },
      "container_id": "container_sales_1",
      "is_cached": false,
      "locked": false
    },
    {
      "id": "node_sales_filter",
      "type": "filter",
      "name": "Filter Orders > $500",
      "x": 1000,
      "y": 180,
      "config": {
        "conditions": [
          {
            "column": "NetAmount",
            "operator": ">",
            "value": "500"
          }
        ],
        "logical_op": "AND",
        "mode": "basic"
      },
      "container_id": "container_sales_1",
      "is_cached": false,
      "locked": false
    },
    {
      "id": "node_sales_summarize",
      "type": "summarize",
      "name": "Summarize by Region & Segment",
      "x": 1200,
      "y": 140,
      "config": {
        "actions": [
          {
            "action": "GroupBy",
            "field": "Region",
            "output_name": "Region"
          },
          {
            "action": "GroupBy",
            "field": "Segment",
            "output_name": "Segment"
          },
          {
            "action": "Sum",
            "field": "NetAmount",
            "output_name": "TotalRevenue"
          },
          {
            "action": "Average",
            "field": "NetAmount",
            "output_name": "AvgOrderValue"
          },
          {
            "action": "Count",
            "field": "OrderID",
            "output_name": "HighValueOrderCount"
          }
        ]
      },
      "container_id": "container_sales_1",
      "is_cached": false,
      "locked": false
