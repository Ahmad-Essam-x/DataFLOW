{
  "name": "Customer RFM Segmentation",
  "description": "Computes RFM (Recency, Frequency, Monetary) scores from order history to segment customers into High Value, At Risk, Lost, and New categories for targeted marketing.",
  "category": "sales",
  "tags": [
    "sales",
    "rfm",
    "segmentation",
    "retention",
    "customer",
    "datetime"
  ],
  "difficulty": "intermediate",
  "containers": [
    {
      "id": "ctr_rfm1",
      "title": "Order Ingestion & Customer Aggregation",
      "x": 60,
      "y": 60,
      "width": 860,
      "height": 380,
      "color": "rgba(59, 130, 246, 0.08)",
      "headerColor": "#3b82f6",
      "collapsed": false,
      "disabled": false
    },
    {
      "id": "ctr_rfm2",
      "title": "RFM Scoring & Strategic Segmentation",
      "x": 960,
      "y": 60,
      "width": 860,
      "height": 380,
      "color": "rgba(245, 158, 11, 0.08)",
      "headerColor": "#f59e0b",
      "collapsed": false,
      "disabled": false
    }
  ],
  "comments": [
    {
      "id": "comment_rfm1",
      "text": "### RFM Segmentation Pipeline\n- Ingests order history records from orders.csv.\n- DateTime standardizes OrderDate strings to ISO dates.\n- Summarize calculates customer OrderCount, TotalSpend, and LastOrderDate.\n- Formula scores Frequency and Monetary value, assigning actionable segment labels.",
      "x": 60,
      "y": 470,
      "width": 520,
      "height": 160,
      "color": "#f59e0b"
    }
  ],
  "nodes": [
    {
      "id": "node_rfm_in",
      "type": "input_data",
      "name": "Input Order History (CSV)",
      "x": 100,
      "y": 170,
      "config": {
        "file_path": "orders.csv",
        "file_type": "csv",
        "delimiter": ",",
        "has_header": true
      }
    },
    {
      "id": "node_rfm_af",
      "type": "auto_field",
      "name": "Auto Detect Types",
      "x": 280,
      "y": 170,
      "config": {
        "fields": []
      }
    },
    {
      "id": "node_rfm_dt",
      "type": "date_time",
      "name": "Parse Order Dates",
      "x": 460,
      "y": 170,
      "config": {
        "column": "OrderDate",
        "conversion_type": "string_to_date",
        "format_template": "yyyy-MM-dd",
        "output_column": "OrderDate_ISO"
      }
    },
    {
      "id": "node_rfm_sum",
      "type": "summarize",
      "name": "Aggregate Customer History",
      "x": 660,
      "y": 170,
      "config": {
        "actions": [
          {
            "field": "CustomerID",
            "action": "GroupBy",
            "output_name": "CustomerID"
          },
          {
            "field": "CustomerName",
            "action": "First",
            "output_name": "CustomerName"
          },
          {
            "field": "OrderDate_ISO",
            "action": "Max",
            "output_name": "LastOrderDate"
          },
          {
            "field": "OrderID",
            "action": "Count",
            "output_name": "OrderCount"
          },
          {
            "field": "OrderValue",
            "action": "Sum",
            "output_name": "TotalSpend"
          },
          {
            "field": "OrderValue",
            "action": "Average",
            "output_name": "AvgOrderValue"
          }
        ]
      }
    },
    {
      "id": "node_rfm_formula",
      "type": "formula",
      "name": "Calculate RFM Tiers",
      "x": 1000,
      "y": 170,
      "config": {
        "formulas": [
          {
            "output_field": "FrequencyScore",
            "type": "integer",
            "expression": "IF([OrderCount] >= 6, 5, IF([OrderCount] >= 4, 4, IF([OrderCount] >= 2, 3, 2)))"
          },
          {
            "output_field": "MonetaryScore",
            "type": "integer",
            "expression": "IF([TotalSpend] >= 3000, 5, IF([TotalSpend] >= 1500, 4, IF([TotalSpend] >= 600, 3, 2)))"
          }
        ]
      }
    },
    {
      "id": "node_rfm_seg",
      "type": "formula",
      "name": "Assign Segment Category",
      "x": 1200,
      "y": 170,
      "config": {
        "formulas": [
          {
            "output_field": "Segment",
            "type": "string",
            "expression": "IF([FrequencyScore] >= 4 AND [MonetaryScore] >= 4, \"High Value VIP\", IF([FrequencyScore] >= 3, \"Promising Growth\", \"Occasional Buyer\"))"
          }
        ]
      }
    },
    {
      "id": "node_rfm_sort",
      "type": "sort",
      "name": "Rank by Total Spend",
      "x": 1380,
      "y": 170,
      "config": {
        "sort_by": [
          {
            "column": "TotalSpend",
            "ascending": false
          }
        ]
      }
    },
    {
      "id": "node_rfm_out",
      "type": "output_data",
      "name": "Export Segmented Customers",
      "x": 1560,
      "y": 170,
      "config": {
        "filename": "customer_rfm_segments",
        "format": "csv",
        "write_mode": "overwrite"
      }
    },
    {
      "id": "node_rfm_browse",
      "type": "browse",
      "name": "Browse RFM Distribution",
      "x": 1560,
      "y": 280,
      "config": {}
    }
  ],
  "connections": [
    {
      "id": "crfm1",
      "source": "node_rfm_in",
      "sourceHandle": "O",
      "target": "node_rfm_af",
      "targetHandle": "I"
    },
    {
      "id": "crfm2",
      "source": "node_rfm_af",
      "sourceHandle": "O",
      "target": "node_rfm_dt",
      "targetHandle": "I"
    },
    {
      "id": "crfm3",
      "source": "node_rfm_dt",
      "sourceHandle": "O",
      "target": "node_rfm_sum",
      "targetHandle": "I"
    },
    {
      "id": "crfm4",
      "source": "node_rfm_sum",
      "sourceHandle": "O",
      "target": "node_rfm_formula",
      "targetHandle": "I"
    },
    {
      "id": "crfm5",
      "source": "node_rfm_formula",
      "sourceHandle": "O",
      "target": "node_rfm_seg",
      "targetHandle": "I"
    },
    {
      "id": "crfm6",
      "source": "node_rfm_seg",
      "sourceHandle": "O",
      "target": "node_rfm_sort",
      "targetHandle": "I"
    },
    {
      "id": "crfm7",
      "source": "node_rfm_sort",
      "sourceHandle": "O",
      "target": "node_rfm_out",
      "targetHandle": "I"
    },
    {
      "id": "crfm8",
      "source": "node_rfm_sort",
      "sourceHandle": "O",
      "target": "node_rfm_browse",
      "targetHandle": "I"
    }
  ]
}