      "targetHandle": "I"
    },
    {
      "id": "c2",
      "source": "node_sales_clean",
      "sourceHandle": "O",
      "target": "node_sales_dt",
      "targetHandle": "I"
    },
    {
      "id": "c3",
      "source": "node_sales_dt",
      "sourceHandle": "O",
      "target": "node_sales_formula",
      "targetHandle": "I"
    },
    {
      "id": "c4",
      "source": "node_sales_formula",
      "sourceHandle": "O",
      "target": "node_sales_filter",
      "targetHandle": "I"
    },
    {
      "id": "c5",
      "source": "node_sales_filter",
      "sourceHandle": "T",
      "target": "node_sales_summarize",
      "targetHandle": "I"
    },
    {
      "id": "c6",
      "source": "node_sales_summarize",
      "sourceHandle": "O",
      "target": "node_sort_1",
      "targetHandle": "I"
    },
    {
      "id": "c7",
      "source": "node_sort_1",
      "sourceHandle": "O",
      "target": "node_sales_multirow",
      "targetHandle": "I"
    },
    {
      "id": "c8",
      "source": "node_sales_multirow",
      "sourceHandle": "O",
      "target": "node_sales_out",
      "targetHandle": "I"
    },
    {
      "id": "c9",
      "source": "node_sales_multirow",
      "sourceHandle": "O",
      "target": "node_sales_browse",
      "targetHandle": "I"
    }
  ],
  "category": "sales",
