{
  "name": "Invoice Data Extraction",
  "description": "Uses an LLM to extract structured fields (vendor name, invoice number, total amount, due date) from free-text invoice descriptions into a clean structured table.",
  "category": "ai_llm",
  "tags": [
    "ai",
    "llm",
    "invoice",
    "extraction",
    "ap",
    "finance"
  ],
  "difficulty": "intermediate",
  "containers": [
    {
      "id": "ctr_ie1",
      "title": "Unstructured Invoices Ingestion",
      "x": 60,
      "y": 60,
      "width": 520,
      "height": 340,
      "color": "rgba(139, 92, 246, 0.08)",
      "headerColor": "#8b5cf6",
      "collapsed": false,
      "disabled": false
    },
    {
      "id": "ctr_ie2",
      "title": "AI Information Extraction & AP Ledger",
      "x": 620,
      "y": 60,
      "width": 1180,
      "height": 340,
      "color": "rgba(59, 130, 246, 0.08)",
      "headerColor": "#3b82f6",
      "collapsed": false,
      "disabled": false
    }
  ],
  "comments": [
    {
      "id": "comment_ie1",
      "text": "### Invoice Processing Methodology\n- Reads unstructured invoice narrative texts from invoices_raw.csv.\n- Trims extra whitespace with Data Clean.\n- Calls LLM Process to extract accounting entities into structured fields.\n- Formulas and filters validate records and prepare an AP payment ledger.",
      "x": 60,
      "y": 430,
      "width": 520,
      "height": 160,
      "color": "#8b5cf6"
    }
  ],
  "nodes": [
    {
      "id": "node_ie_in",
      "type": "input_data",
      "name": "Input Raw Invoices (CSV)",
      "x": 100,
      "y": 170,
      "config": {
        "file_path": "invoices_raw.csv",
        "file_type": "csv",
        "delimiter": ",",
        "has_header": true
      }
    },
    {
      "id": "node_ie_clean",
      "type": "clean",
      "name": "Trim Invoice Text",
      "x": 300,
      "y": 170,
      "config": {
        "columns": [
          "InvoiceText"
        ],
        "trim_whitespace": true,
        "case_transformation": "none",
        "remove_empty_rows": true
      }
    },
    {
      "id": "node_ie_llm",
      "type": "llm_process",
      "name": "AI Field Extractor",
      "x": 660,
      "y": 170,
      "config": {
        "provider_type": "ollama",
        "model": "llama3.2",
        "user_prompt_template": "Extract invoice information from:\n{{[InvoiceText]}}\nFormat as JSON with keys: vendor, invoice_num, amount.",
        "output_column": "ExtractedJSON",
        "on_error": "null"
      }
    },
    {
      "id": "node_ie_formula",
      "type": "formula",
      "name": "Tag Processing Status",
      "x": 880,
      "y": 170,
      "config": {
        "formulas": [
          {
            "output_field": "AP_BatchID",
            "type": "string",
            "expression": "'BATCH-2024Q4'"
          }
        ]
      }
    },
    {
      "id": "node_ie_filter",
      "type": "filter",
      "name": "Filter Processed Records",
      "x": 1080,
      "y": 170,
      "config": {
        "mode": "basic",
        "logical_op": "AND",
        "conditions": [
          {
            "column": "AP_BatchID",
            "operator": "==",
            "value": "BATCH-2024Q4"
          }
        ]
      }
    },
    {
      "id": "node_ie_sort",
      "type": "sort",
      "name": "Sort by Invoice ID",
      "x": 1280,
      "y": 170,
      "config": {
        "sort_by": [
          {
            "column": "InvoiceID",
            "ascending": true
          }
        ]
      }
    },
    {
      "id": "node_ie_out",
      "type": "output_data",
      "name": "Export Structured AP Ledger",
      "x": 1480,
      "y": 170,
      "config": {
        "filename": "structured_ap_ledger",
        "format": "csv",
        "write_mode": "overwrite"
      }
    },
    {
      "id": "node_ie_browse",
      "type": "browse",
      "name": "Browse AP Ledger",
      "x": 1660,
      "y": 170,
      "config": {}
    }
  ],
  "connections": [
    {
      "id": "cie1",
      "source": "node_ie_in",
      "sourceHandle": "O",
      "target": "node_ie_clean",
      "targetHandle": "I"
    },
    {
      "id": "cie2",
      "source": "node_ie_clean",
      "sourceHandle": "O",
      "target": "node_ie_llm",
      "targetHandle": "I"
    },
    {
      "id": "cie3",
      "source": "node_ie_llm",
      "sourceHandle": "O",
      "target": "node_ie_formula",
      "targetHandle": "I"
    },
    {
      "id": "cie4",
      "source": "node_ie_formula",
      "sourceHandle": "O",
      "target": "node_ie_filter",
      "targetHandle": "I"
    },
    {
      "id": "cie5",
      "source": "node_ie_filter",
      "sourceHandle": "T",
      "target": "node_ie_sort",
      "targetHandle": "I"
    },
    {
      "id": "cie6",
      "source": "node_ie_sort",
      "sourceHandle": "O",
      "target": "node_ie_out",
      "targetHandle": "I"
    },
    {
      "id": "cie7",
      "source": "node_ie_out",
      "sourceHandle": "O",
      "target": "node_ie_browse",
      "targetHandle": "I"
    }
  ]
}