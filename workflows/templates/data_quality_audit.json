{
  "name": "Data Quality Audit & Hygiene Scorecard",
  "description": "Profiles uncurated customer records for nulls, irregular text casing, whitespace padding, and duplicate emails. Separates clean records from flagged accounts and produces an executive audit scorecard.",
  "category": "data_quality",
  "tags": [
    "data_quality",
    "profiling",
    "clean",
    "unique",
    "nulls",
    "audit"
  ],
  "difficulty": "beginner",
  "containers": [
    {
      "id": "ctr_dq1",
      "title": "Data Cleansing & Duplicate Isolation",
      "x": 60,
      "y": 60,
      "width": 860,
      "height": 380,
      "color": "rgba(16, 185, 129, 0.08)",
      "headerColor": "#10b981",
      "collapsed": false,
      "disabled": false
    },
    {
      "id": "ctr_dq2",
      "title": "Validation Gate & Quality Scorecard",
      "x": 960,
      "y": 60,
      "width": 880,
      "height": 380,
      "color": "rgba(245, 158, 11, 0.08)",
      "headerColor": "#f59e0b",
      "collapsed": false,
      "disabled": false
    }
  ],
  "comments": [
    {
      "id": "comment_dq1",
      "text": "### Data Quality Assurance Pipeline\n- **Auto Field**: Detects optimal column data types.\n- **Data Clean**: Strips whitespace padding and standardizes State casing.\n- **Unique**: Isolates duplicate customer accounts sharing the same email address.\n- **Formula**: Flags incomplete accounts missing Income or Phone credentials.\n- **Filter**: Routes validated records to clean storage and flags errors for audit.",
      "x": 60,
      "y": 470,
      "width": 500,
      "height": 160,
      "color": "#10b981"
    }
  ],
  "nodes": [
    {
      "id": "node_dq_in",
      "type": "input_data",
      "name": "Input Raw Accounts (CSV)",
      "x": 100,
      "y": 170,
      "config": {
        "file_path": "dirty_customer_data.csv",
        "file_type": "csv",
        "delimiter": ",",
        "has_header": true
      }
    },
    {
      "id": "node_dq_af",
      "type": "auto_field",
      "name": "Auto Detect Types",
      "x": 280,
      "y": 170,
      "config": {
        "fields": []
      }
    },
    {
      "id": "node_dq_clean",
      "type": "clean",
      "name": "Clean Strings & State",
      "x": 460,
      "y": 170,
      "config": {
        "columns": [
          "FullName",
          "Email",
          "State"
        ],
        "trim_whitespace": true,
        "case_transformation": "title",
        "remove_empty_rows": false
      }
    },
    {
      "id": "node_dq_unique",
      "type": "unique",
      "name": "Isolate Duplicate Emails",
      "x": 660,
      "y": 170,
      "config": {
        "columns": [
          "Email"
        ]
      }
    },
    {
      "id": "node_dq_formula",
      "type": "formula",
      "name": "Evaluate Completeness",
      "x": 1000,
      "y": 170,
      "config": {
        "formulas": [
          {
            "output_field": "QualityStatus",
            "type": "string",
            "expression": "IF(IsNull([AnnualIncome]) OR IsNull([PhoneNumber]), \"Incomplete\", \"Verified\")"
          }
        ]
      }
    },
    {
      "id": "node_dq_filter",
      "type": "filter",
      "name": "Route Verified vs Incomplete",
      "x": 1200,
      "y": 170,
      "config": {
        "mode": "basic",
        "logical_op": "AND",
        "conditions": [
          {
            "column": "QualityStatus",
            "operator": "==",
            "value": "Verified"
          }
        ]
      }
    },
    {
      "id": "node_dq_sum",
      "type": "summarize",
      "name": "Quality Audit Scorecard",
      "x": 1400,
      "y": 280,
      "config": {
        "actions": [
          {
            "field": "QualityStatus",
            "action": "GroupBy",
            "output_name": "QualityStatus"
          },
          {
            "field": "CustomerID",
            "action": "Count",
            "output_name": "RecordCount"
          }
        ]
      }
    },
    {
      "id": "node_dq_sort",
      "type": "sort",
      "name": "Sort Scorecard",
      "x": 1600,
      "y": 280,
      "config": {
        "sort_by": [
          {
            "column": "RecordCount",
            "ascending": false
          }
        ]
      }
    },
    {
      "id": "node_dq_out",
      "type": "output_data",
      "name": "Export Verified Accounts",
      "x": 1420,
      "y": 140,
      "config": {
        "filename": "verified_customer_accounts",
        "format": "csv",
        "write_mode": "overwrite"
      }
    },
    {
      "id": "node_dq_browse",
      "type": "browse",
      "name": "Browse Clean Dataset",
      "x": 1620,
      "y": 140,
      "config": {}
    }
  ],
  "connections": [
    {
      "id": "cdq1",
      "source": "node_dq_in",
      "sourceHandle": "O",
      "target": "node_dq_af",
      "targetHandle": "I"
    },
    {
      "id": "cdq2",
      "source": "node_dq_af",
      "sourceHandle": "O",
      "target": "node_dq_clean",
      "targetHandle": "I"
    },
    {
      "id": "cdq3",
      "source": "node_dq_clean",
      "sourceHandle": "O",
      "target": "node_dq_unique",
      "targetHandle": "I"
    },
    {
      "id": "cdq4",
      "source": "node_dq_unique",
      "sourceHandle": "U",
      "target": "node_dq_formula",
      "targetHandle": "I"
    },
    {
      "id": "cdq5",
      "source": "node_dq_formula",
      "sourceHandle": "O",
      "target": "node_dq_filter",
      "targetHandle": "I"
    },
    {
      "id": "cdq6",
      "source": "node_dq_filter",
      "sourceHandle": "T",
      "target": "node_dq_out",
      "targetHandle": "I"
    },
    {
      "id": "cdq7",
      "source": "node_dq_out",
      "sourceHandle": "O",
      "target": "node_dq_browse",
      "targetHandle": "I"
    },
    {
      "id": "cdq8",
      "source": "node_dq_formula",
      "sourceHandle": "O",
      "target": "node_dq_sum",
      "targetHandle": "I"
    },
    {
      "id": "cdq9",
      "source": "node_dq_sum",
      "sourceHandle": "O",
      "target": "node_dq_sort",
      "targetHandle": "I"
    }
  ]
}