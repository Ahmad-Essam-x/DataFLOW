{
  "name": "Data Quality Audit",
  "description": "Profiles a dataset for nulls, type inconsistencies, duplicates, and outliers. Separates clean records from flagged ones and produces a quality audit summary report.",
  "category": "data_quality",
  "tags": [
    "data quality",
    "profiling",
    "nulls",
    "duplicates",
    "audit",
    "validation"
  ],
  "difficulty": "beginner",
  "containers": [
