{
  "name": "Customer Sentiment Analysis",
  "description": "Reads customer product feedback, cleans text, executes AI sentiment classification using LLM Process, and routes negative reviews for customer escalation.",
  "category": "ai_llm",
  "tags": [
    "ai",
    "llm",
    "sentiment",
    "nlp",
    "reviews",
    "customer"
  ],
  "difficulty": "intermediate",
  "containers": [
    {
      "id": "ctr_s1",
      "title": "Feedback Ingestion & Text Preparation",
      "x": 60,
      "y": 60,
      "width": 640,
      "height": 340,
      "color": "rgba(139, 92, 246, 0.08)",
      "headerColor": "#8b5cf6",
      "collapsed": false,
      "disabled": false
    },
    {
      "id": "ctr_s2",
      "title": "AI Classification & Customer Escalation",
      "x": 740,
      "y": 60,
      "width": 1040,
      "height": 340,
      "color": "rgba(239, 68, 68, 0.08)",
      "headerColor": "#ef4444",
      "collapsed": false,
      "disabled": false
    }
  ],
  "comments": [
    {
      "id": "comment_s1",
      "text": "### AI Sentiment Pipeline Architecture\n- Ingests customer review records from customer_reviews.csv.\n- Data Clean strips leading and trailing whitespaces.\n- LLM Process classifies sentiment with fallback for offline mode (`on_error='null'`).\n- Filter isolates low-rated customer accounts (StarRating <= 2) for retention review.",
      "x": 60,
      "y": 430,
      "width": 520,
      "height": 160,
      "color": "#8b5cf6"
    }
  ],
  "nodes": [
    {
      "id": "node_s_in",
      "type": "input_data",
      "name": "Input Customer Reviews (CSV)",
      "x": 100,
      "y": 170,
      "config": {
        "file_path": "customer_reviews.csv",
        "file_type": "csv",
        "delimiter": ",",
        "has_header": true
      }
    },
    {
      "id": "node_s_af",
      "type": "auto_field",
      "name": "Auto Detect Types",
      "x": 280,
      "y": 170,
      "config": {
        "fields": []
      }
    },
    {
      "id": "node_s_clean",
      "type": "clean",
      "name": "Trim Review Text",
      "x": 460,
      "y": 170,
      "config": {
        "columns": [
          "ReviewText"
        ],
        "trim_whitespace": true,
        "case_transformation": "none",
        "remove_empty_rows": true
      }
    },
    {
      "id": "node_s_llm",
      "type": "llm_process",
      "name": "AI Sentiment Classifier",
      "x": 780,
      "y": 170,
      "config": {
        "provider_type": "ollama",
        "model": "llama3.2",
        "user_prompt_template": "Classify the sentiment of this review as Positive, Neutral, or Negative:\n{{[ReviewText]}}",
        "output_column": "Sentiment",
        "on_error": "null"
      }
    },
    {
      "id": "node_s_filter",
      "type": "filter",
      "name": "Escalate Low Ratings (<= 2 Stars)",
      "x": 1000,
      "y": 170,
      "config": {
        "mode": "basic",
        "logical_op": "AND",
        "conditions": [
          {
            "column": "StarRating",
            "operator": "<=",
            "value": "2"
          }
        ]
      }
    },
    {
      "id": "node_s_sort",
      "type": "sort",
      "name": "Sort by Rating Asc",
      "x": 1200,
      "y": 170,
      "config": {
        "sort_by": [
          {
            "column": "StarRating",
            "ascending": true
          }
        ]
      }
    },
    {
      "id": "node_s_out",
      "type": "output_data",
      "name": "Export Escalation Queue",
      "x": 1400,
      "y": 170,
      "config": {
        "filename": "negative_review_escalations",
        "format": "csv",
        "write_mode": "overwrite"
      }
    },
    {
      "id": "node_s_browse",
      "type": "browse",
      "name": "Browse Escalation Queue",
      "x": 1580,
      "y": 170,
      "config": {}
    }
  ],
  "connections": [
    {
      "id": "cs1",
      "source": "node_s_in",
      "sourceHandle": "O",
      "target": "node_s_af",
      "targetHandle": "I"
    },
    {
      "id": "cs2",
      "source": "node_s_af",
      "sourceHandle": "O",
      "target": "node_s_clean",
      "targetHandle": "I"
    },
    {
      "id": "cs3",
      "source": "node_s_clean",
      "sourceHandle": "O",
      "target": "node_s_llm",
      "targetHandle": "I"
    },
    {
      "id": "cs4",
      "source": "node_s_llm",
      "sourceHandle": "O",
      "target": "node_s_filter",
      "targetHandle": "I"
    },
    {
      "id": "cs5",
      "source": "node_s_filter",
      "sourceHandle": "T",
      "target": "node_s_sort",
      "targetHandle": "I"
    },
    {
      "id": "cs6",
      "source": "node_s_sort",
      "sourceHandle": "O",
      "target": "node_s_out",
      "targetHandle": "I"
    },
    {
      "id": "cs7",
      "source": "node_s_out",
      "sourceHandle": "O",
      "target": "node_s_browse",
      "targetHandle": "I"
    }
  ]
}