{
  "name": "Sales Pipeline & Lead Velocity Report",
  "description": "Reads a CRM export, calculates probability-weighted deal revenue, excludes lost opportunities, summarizes pipeline velocity by representative, and calculates cumulative performance contributions.",
  "category": "sales",
  "tags": [
    "sales",
    "pipeline",
    "crm",
    "revenue",
    "multi_row_formula",
    "forecast"
  ],
  "difficulty": "intermediate",
  "containers": [
    {
      "id": "ctr_sp1",
      "title": "Pipeline Transformation & Weighted Valuation",
      "x": 60,
      "y": 60,
      "width": 860,
      "height": 380,
      "color": "rgba(59, 130, 246, 0.08)",
      "headerColor": "#3b82f6",
      "collapsed": false,
      "disabled": false
    },
    {
      "id": "ctr_sp2",
      "title": "Representative Ranking & Velocity Summary",
      "x": 960,
      "y": 60,
      "width": 860,
      "height": 380,
      "color": "rgba(34, 197, 94, 0.08)",
      "headerColor": "#16a34a",
      "collapsed": false,
      "disabled": false
    }
  ],
  "comments": [
    {
      "id": "comment_sp1",
      "text": "### Sales Pipeline Forecasting Methodology\n- Ingests raw deal stages, accounts, and values from CRM.\n- Formula calculates Weighted Revenue = DealValue * Probability.\n- Filter eliminates closed-lost deals from active projections.\n- Summarize aggregates total and weighted pipeline per representative.\n- Multi-Row Formula computes cumulative running pipeline contributions.",
      "x": 60,
      "y": 470,
      "width": 520,
      "height": 160,
      "color": "#3b82f6"
    }
  ],
  "nodes": [
    {
      "id": "node_sp_in",
      "type": "input_data",
      "name": "Input CRM Deals (CSV)",
      "x": 100,
      "y": 170,
      "config": {
        "file_path": "crm_pipeline.csv",
        "file_type": "csv",
        "delimiter": ",",
        "has_header": true
      }
    },
    {
      "id": "node_sp_af",
      "type": "auto_field",
      "name": "Auto Detect Types",
      "x": 280,
      "y": 170,
      "config": {
        "fields": []
      }
    },
    {
      "id": "node_sp_clean",
      "type": "clean",
      "name": "Clean Rep & Stage Names",
      "x": 460,
      "y": 170,
      "config": {
        "columns": [
          "SalesRep",
          "Stage",
          "Region"
        ],
        "trim_whitespace": true,
        "case_transformation": "title",
        "remove_empty_rows": false
      }
    },
    {
      "id": "node_sp_formula",
      "type": "formula",
      "name": "Calculate Weighted Value",
      "x": 660,
      "y": 170,
      "config": {
        "formulas": [
          {
            "output_field": "WeightedRevenue",
            "type": "float",
            "expression": "[DealValue] * [Probability]"
          }
        ]
      }
    },
    {
      "id": "node_sp_filter",
      "type": "filter",
      "name": "Filter Out Closed Lost",
      "x": 1000,
      "y": 170,
      "config": {
        "mode": "basic",
        "logical_op": "AND",
        "conditions": [
          {
            "column": "Stage",
            "operator": "!=",
            "value": "Closed Lost"
          }
        ]
      }
    },
    {
      "id": "node_sp_sum",
      "type": "summarize",
      "name": "Summarize by Sales Rep",
      "x": 1180,
      "y": 170,
      "config": {
        "actions": [
          {
            "field": "SalesRep",
            "action": "GroupBy",
            "output_name": "SalesRep"
          },
          {
            "field": "DealValue",
            "action": "Sum",
            "output_name": "PipelineTotal"
          },
          {
            "field": "WeightedRevenue",
            "action": "Sum",
            "output_name": "WeightedPipeline"
          },
          {
            "field": "DealID",
            "action": "Count",
            "output_name": "OpportunityCount"
          }
        ]
      }
    },
    {
      "id": "node_sp_sort",
      "type": "sort",
      "name": "Rank by Weighted Pipeline",
      "x": 1360,
      "y": 170,
      "config": {
        "sort_by": [
          {
            "column": "WeightedPipeline",
            "ascending": false
          }
        ]
      }
    },
    {
      "id": "node_sp_multirow",
      "type": "multi_row_formula",
      "name": "Cumulative Contribution",
      "x": 1540,
      "y": 170,
      "config": {
        "output_field": "CumulativeWeighted",
        "is_new_field": true,
        "output_type": "float",
        "values_for_rows_not_exist": "0",
        "group_by_fields": [],
        "expression": "[Row-1:CumulativeWeighted] + [WeightedPipeline]"
      }
    },
    {
      "id": "node_sp_out",
      "type": "output_data",
      "name": "Export Pipeline Forecast",
      "x": 1720,
      "y": 170,
      "config": {
        "filename": "sales_pipeline_forecast",
        "format": "csv",
        "write_mode": "overwrite"
      }
    },
    {
      "id": "node_sp_browse",
      "type": "browse",
      "name": "Browse Forecast Profile",
      "x": 1720,
      "y": 280,
      "config": {}
    }
  ],
  "connections": [
    {
      "id": "csp1",
      "source": "node_sp_in",
      "sourceHandle": "O",
      "target": "node_sp_af",
      "targetHandle": "I"
    },
    {
      "id": "csp2",
      "source": "node_sp_af",
      "sourceHandle": "O",
      "target": "node_sp_clean",
      "targetHandle": "I"
    },
    {
      "id": "csp3",
      "source": "node_sp_clean",
      "sourceHandle": "O",
      "target": "node_sp_formula",
      "targetHandle": "I"
    },
    {
      "id": "csp4",
      "source": "node_sp_formula",
      "sourceHandle": "O",
      "target": "node_sp_filter",
      "targetHandle": "I"
    },
    {
      "id": "csp5",
      "source": "node_sp_filter",
      "sourceHandle": "T",
      "target": "node_sp_sum",
      "targetHandle": "I"
    },
    {
      "id": "csp6",
      "source": "node_sp_sum",
      "sourceHandle": "O",
      "target": "node_sp_sort",
      "targetHandle": "I"
    },
    {
      "id": "csp7",
      "source": "node_sp_sort",
      "sourceHandle": "O",
      "target": "node_sp_multirow",
      "targetHandle": "I"
    },
    {
      "id": "csp8",
      "source": "node_sp_multirow",
      "sourceHandle": "O",
      "target": "node_sp_out",
      "targetHandle": "I"
    },
    {
      "id": "csp9",
      "source": "node_sp_multirow",
      "sourceHandle": "O",
      "target": "node_sp_browse",
      "targetHandle": "I"
    }
  ]
}