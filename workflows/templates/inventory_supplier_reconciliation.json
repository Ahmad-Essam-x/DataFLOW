          ],
          [
            "SUP105",
            "Titan Tooling Works",
            15,
            "B+"
          ]
        ]
      }
    },
    {
      "id": "node_inv_join",
      "type": "join",
      "name": "Join Stock with Suppliers",
      "x": 680,
      "y": 200,
      "config": {
        "join_mode": "specific_fields",
        "join_keys": [
          {
            "left_key": "BatchPart_1",
            "right_key": "SupplierID"
          }
        ]
      }
    },
    {
      "id": "node_inv_params",
      "type": "text_input",
      "name": "Audit Rate Parameters",
      "x": 680,
      "y": 340,
      "config": {
        "columns": [
          "HoldingRate",
          "Currency"
        ],
        "data": [
          [
            0.085,
            "USD"
          ]
        ]
      }
    },
    {
      "id": "node_inv_append",
      "type": "append_fields",
      "name": "Append Financial Parameters",
      "x": 900,
      "y": 220,
      "config": {
        "cartesian_mode": "error_16",
        "source_prefix": "Param_"
      }
    },
    {
      "id": "node_inv_recid",
      "type": "record_id",
      "name": "Generate Audit Ledger ID",
      "x": 1120,
      "y": 220,
      "config": {
        "column_name": "AuditTrackingID",
        "start_value": 1001,
        "position": "first"
      }
    },
    {
      "id": "node_inv_out",
      "type": "output_data",
      "name": "Export Audit Ledger",
      "x": 1320,
      "y": 220,
      "config": {
        "filename": "inventory_audit_ledger",
        "format": "csv",
        "write_mode": "overwrite"
      }
    }
  ],
