# Dynamic uploaded files (session uploads with 8-hex uuid prefix)
data/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]_*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Workflows: only the curated samples are tracked. Any other workflow saved here is private by default
